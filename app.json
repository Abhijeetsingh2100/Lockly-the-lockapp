{
  "expo": {
    "name": "SantaProtect",
    "slug": "Lockly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SantaProtectLogo.png",
    "scheme": "lockly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/SantaProtectLogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/SantaProtectLogo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/SantaProtectLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abhijeetsingh200.Lockly",
      "permissions": [
        "QUERY_ALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/SantaProtectLogo.png",
            "imageWidth": 200
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2dc1d0c-5b3b-4050-98ec-7c64e6314106"
      }
    },
    "owner": "abhijeetsingh200"
  }
}
